<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tracker_launch</name>
  <version>0.1.0</version>
  <description>
    Launch files for the XRP perception stack: the tracking camera, the
    effects camera, the object tracker, and the Foxglove bridge.
  </description>
  <maintainer email="tambuprecious60@gmail.com">th3kit3</maintainer>
  <license>MIT</license>

  <exec_depend>tracker</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Optional at runtime; the launch file can skip it with foxglove:=false -->
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
